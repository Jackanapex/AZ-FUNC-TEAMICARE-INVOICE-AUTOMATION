{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "blobs": {
        "maxDegreeOfParallelism": 1,
        "poisonBlobThreshold": 5
    },
    "queues": {
        "visibilityTimeout" : "00:00:10",
        "batchSize": 1,
        "maxDequeueCount": 5
    }
  }
}